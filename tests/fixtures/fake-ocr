#!/bin/sh
# A fake ocr (Open Code Review) for the tests of chaoshub. It writes
# canned JSON to the --output file of `ocr review --format json`.
#
# FAKE_LOG: when set, the fake writes its arguments to $FAKE_LOG.argv, its
# env to $FAKE_LOG.env, its directory to $FAKE_LOG.cwd and the text of
# the --background-file to $FAKE_LOG.background.
# FAKE_MODE: "fail" exits with 1, "sleep" waits 30 seconds, "nojson"
# writes no JSON. Other values give a normal run.
if [ -n "$FAKE_LOG" ]; then
  printf '%s\n' "$@" > "$FAKE_LOG.argv"
  env > "$FAKE_LOG.env"
  pwd -P > "$FAKE_LOG.cwd"
fi
out=""
while [ $# -gt 0 ]; do
  case "$1" in
    --output) out=$2; shift 2 ;;
    --background-file)
      if [ -n "$FAKE_LOG" ]; then cat "$2" > "$FAKE_LOG.background"; fi
      shift 2 ;;
    *) shift ;;
  esac
done
echo "[ocr] 1 file(s) changed, reviewing 1" >&2
case "$FAKE_MODE" in
  fail)
    # A failed review prints its JSON result to stderr before the error.
    printf '{\n  "status": "failed"\n}\n' >&2
    echo "Error: resolve LLM endpoint: no valid LLM endpoint configured" >&2
    exit 1 ;;
  sleep) exec sleep 30 ;;
  nojson) exit 0 ;;
esac
printf '\033[2m[ocr] Plan completed for src/lib.rs\033[0m\n' >&2
cat > "$out" <<'JSON'
{
  "status": "success",
  "llm": {"provider": "anthropic", "model": "claude-opus-4-6"},
  "summary": {
    "files_reviewed": 1,
    "comments": 2,
    "total_tokens": 21344,
    "input_tokens": 18012,
    "output_tokens": 3332,
    "elapsed": "1m12s"
  },
  "comments": [
    {
      "path": "src/lib.rs",
      "content": "The name is not trimmed.",
      "start_line": 4,
      "end_line": 4,
      "category": "style",
      "severity": "low"
    },
    {
      "path": "src/lib.rs",
      "content": "The greeting ignores an empty name, so the output has a trailing space.",
      "start_line": 3,
      "end_line": 5,
      "category": "bug",
      "severity": "high",
      "existing_code": "format!(\"Hello {}\", name)",
      "suggestion_code": "format!(\"Hello {}\", name.trim())"
    }
  ]
}
JSON
