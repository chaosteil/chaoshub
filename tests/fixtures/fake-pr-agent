#!/bin/sh
# A fake pr-agent for the tests of chaoshub. It writes canned JSON to the
# --json-output file of review, improve and describe.
#
# FAKE_LOG: when set, the fake writes its arguments to $FAKE_LOG.argv, its
# env to $FAKE_LOG.env and its directory to $FAKE_LOG.cwd.
# FAKE_MODE: "fail" exits with 3, "sleep" waits 30 seconds, "nojson"
# writes no JSON. Other values give a normal run.
# FAKE_DELAY: the seconds to wait before the result. The default is 0.
if [ -n "$FAKE_LOG" ]; then
  printf '%s\n' "$@" > "$FAKE_LOG.argv"
  env > "$FAKE_LOG.env"
  pwd -P > "$FAKE_LOG.cwd"
fi
out=""
tool=""
while [ $# -gt 0 ]; do
  case "$1" in
    --json-output) out=$2; shift 2 ;;
    --pr_url) shift 2 ;;
    *) tool=$1; shift ;;
  esac
done
echo "starting $tool" >&2
case "$FAKE_MODE" in
  fail) echo "model error: no key" >&2; exit 3 ;;
  sleep) exec sleep 30 ;;
  nojson) exit 0 ;;
esac
sleep "${FAKE_DELAY:-0}"
echo "2026-11-05 17:00:00.000 | INFO     | pr_agent.tools:run:1 - $tool done"
case "$tool" in
  review) cat > "$out" <<'JSON'
{
  "review": {
    "estimated_effort_to_review_[1-5]": 2,
    "relevant_tests": "No",
    "key_issues_to_review": [
      {
        "relevant_file": "src/lib.rs",
        "issue_header": "Possible Bug",
        "issue_content": "The greeting ignores an empty name, so the output has a trailing space.",
        "start_line": 3,
        "end_line": 5
      }
    ],
    "security_concerns": "No"
  },
  "usage": {"prompt_tokens": 11000, "completion_tokens": 1000, "total_tokens": 12000},
  "coverage": {"files_not_reviewed": [], "files_partially_reviewed": []}
}
JSON
  ;;
  improve) cat > "$out" <<'JSON'
{
  "code_suggestions": [
    {
      "relevant_file": "src/lib.rs",
      "language": "rust",
      "existing_code": "format!(\"Hello {}\", name)",
      "improved_code": "format!(\"Hello {}\", name.trim())",
      "suggestion_content": "Trim the name before the greeting uses it.",
      "one_sentence_summary": "Trim the name",
      "relevant_lines_start": 4,
      "relevant_lines_end": 4,
      "label": "possible issue",
      "score": 8
    }
  ],
  "usage": {"prompt_tokens": 9000, "completion_tokens": 800, "total_tokens": 9800}
}
JSON
  ;;
  describe) cat > "$out" <<'JSON'
{
  "title": "Add a greeting",
  "type": ["Enhancement"],
  "description": "- Add a greeting function\n- Test the greeting",
  "pr_files": [
    {
      "filename": "src/lib.rs",
      "changes_title": "Add the greeting function",
      "changes_summary": "- Add `greet`",
      "label": "enhancement"
    }
  ],
  "usage": {"prompt_tokens": 5000, "completion_tokens": 300, "total_tokens": 5300}
}
JSON
  ;;
esac
